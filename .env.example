# ── CoopAtlas Ops — environment template ─────────────────────────────
# Copy to .env and fill in. All values optional; the service degrades
# gracefully when credentials are missing (see src/config.ts).

# ── State store (Supabase) ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Classifier (OpenCode Zen / DeepSeek) ──────────────────────────────
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_API_KEY=
ZEN_MODEL=deepseek-v4-flash

# ── GitHub dispatch ───────────────────────────────────────────────────
GITHUB_OWNER=ishameless
# Either GITHUB_TOKEN or GH_TOKEN is accepted (same value).
GITHUB_TOKEN=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
OPS_ADMIN_PHONE=

# ── Inbound webhook secrets ───────────────────────────────────────────
SENTRY_WEBHOOK_SECRET=
OPS_CALLBACK_TOKEN=dev-callback-token

# ── Escalation ────────────────────────────────────────────────────────
ESCALATION_MINUTES=30
ESCALATION_CRON=*/10 * * * *

# ── Public base URL (executor callbacks come back here) ───────────────
# When mounted in the backend: https://coopatlas-backend.onrender.com/ops
# Standalone:                   http://localhost:10001/ops
OPS_BASE_URL=http://localhost:10001/ops

# ── Standalone server only ────────────────────────────────────────────
PORT=10001
