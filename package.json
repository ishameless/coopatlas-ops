{
  "name": "coopatlas-ops",
  "version": "0.1.0",
  "description": "CoopAtlas AI Ops orchestrator: Sentry webhooks, WhatsApp control plane, auto-patch policy, GitHub dispatch, escalation cron. Mounts into coopatlas-backend at /ops.",
  "main": "dist/router.js",
  "types": "dist/router.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai-ops",
    "sentry",
    "whatsapp",
    "orchestrator"
  ],
  "author": "CoopAtlas",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
